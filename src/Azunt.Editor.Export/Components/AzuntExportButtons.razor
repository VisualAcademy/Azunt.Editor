@namespace Azunt.Editor.Export.Components
@using Azunt.Editor.Export.Models
<div class="azunt-editor-export-actions" role="group" aria-label="Export document">
    <button type="button" @onclick="() => ExportRequested.InvokeAsync(EditorExportFormat.Pdf)">Download PDF</button>
    <button type="button" @onclick="() => ExportRequested.InvokeAsync(EditorExportFormat.Docx)">Download Word</button>
    <button type="button" @onclick="() => ExportRequested.InvokeAsync(EditorExportFormat.Xlsx)">Download Excel</button>
</div>
@code {
    [Parameter] public EventCallback<EditorExportFormat> ExportRequested { get; set; }
}

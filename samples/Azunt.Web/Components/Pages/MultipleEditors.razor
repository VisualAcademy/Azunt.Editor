@page "/editor/blazor/multiple"
@rendermode InteractiveServer
@using Azunt.Editor.Components
@using Microsoft.JSInterop
@inject IJSRuntime JS
@implements IAsyncDisposable

<h1>Multiple Editors — Blazor Server</h1>
<p>Test independent content, formatting, history, menus and fullscreen. Save captures HTML in component memory only.</p>
@foreach (var field in _fields)
{
    <section @key="field.Id">
        <h2>@field.Name</h2>
        <AzuntEditor @ref="field.Editor" Id="@field.Id" Name="@field.Name" @bind-Value="field.Html"
            Height="@(field.Compact ? 112 : 240)" ToolbarMode="Compact"
            ShowMenuBar="@(!field.Compact)" ShowToolbarGroupLabels="@(!field.Compact)" />
        @if (field.Removable)
        {
            <button type="button" @onclick="() => _fields.Remove(field)">Remove @field.Name</button>
        }
    </section>
}
<div class="actions">
    <button type="button" @onclick="AddEditor">Add editor</button>
    <button type="button" @onclick="OpenModal">Open modal</button>
    <button type="button" class="primary" @onclick="SaveAllAsync">Save all HTML</button>
</div>
<dialog @ref="_dialog" class="multiple-editor-modal" aria-labelledby="multi-blazor-modal-title" data-blazor-modal="true">
    <h2 id="multi-blazor-modal-title">Modal editors</h2>
    @if (_modalOpen)
    {
        @foreach (var field in _modalFields)
        {
            <section @key="field.Id">
                <h2>@field.Name</h2>
                <AzuntEditor @ref="field.Editor" Id="@field.Id" Name="@field.Name" @bind-Value="field.Html"
                    Height="112" ToolbarMode="Compact" ShowMenuBar="false" ShowToolbarGroupLabels="false" />
            </section>
        }
        <div class="actions"><button type="button" @onclick="CloseModalAsync">Save modal and close</button></div>
    }
</dialog>
<h2>Saved HTML (escaped source)</h2>
<pre class="source" aria-live="polite">@_saved</pre>

@code {
    private sealed class Field(string id, string name, string html, bool compact = true, bool removable = false)
    {
        public string Id { get; } = id;
        public string Name { get; } = name;
        public string Html { get; set; } = html;
        public bool Compact { get; } = compact;
        public bool Removable { get; } = removable;
        public AzuntEditor? Editor { get; set; }
    }
    private readonly List<Field> _fields = [
        new("multi-blazor-document", "Document", "<p>Document content</p>", false),
        new("multi-blazor-notes", "Notes", "<p>Internal notes</p>"),
        new("multi-blazor-comments", "Comments", "<p>Approval comments</p>")];
    private List<Field> _modalFields = [];
    private string _modalNotes = "<p>Modal notes</p>", _modalComments = "<p>Modal comments</p>", _saved = "";
    private int _next, _modalGeneration;
    private bool _modalOpen, _showPending;
    private ElementReference _dialog;
    private IJSObjectReference? _module;

    private void AddEditor()
    {
        var n = ++_next;
        _fields.Add(new($"multi-blazor-extra-{n}", $"Extra{n}", "<p>Extra editor</p>", removable: true));
    }
    private void OpenModal()
    {
        if (_modalOpen) return;
        var n = ++_modalGeneration;
        _modalFields = [new($"multi-blazor-modal-notes-{n}", "ModalNotes", _modalNotes),
            new($"multi-blazor-modal-comments-{n}", "ModalComments", _modalComments)];
        _modalOpen = _showPending = true;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) _module = await JS.InvokeAsync<IJSObjectReference>("import", "/js/multiple-editors.js");
        if (_showPending && _module is not null)
        {
            _showPending = false;
            await _module.InvokeVoidAsync("showModal", _dialog);
        }
    }
    private async Task CloseModalAsync()
    {
        foreach (var field in _modalFields)
            if (field.Editor is not null) field.Html = await field.Editor.GetHtmlAsync();
        _modalNotes = _modalFields[0].Html;
        _modalComments = _modalFields[1].Html;
        if (_module is not null) await _module.InvokeVoidAsync("closeModal", _dialog);
        _modalOpen = false;
        _modalFields.Clear();
    }
    private async Task SaveAllAsync()
    {
        var result = new Dictionary<string, string> { ["ModalNotes"] = _modalNotes, ["ModalComments"] = _modalComments };
        foreach (var field in _fields.Concat(_modalFields))
        {
            if (field.Editor is not null) field.Html = await field.Editor.GetHtmlAsync();
            result[field.Name] = field.Html;
        }
        _saved = System.Text.Json.JsonSerializer.Serialize(result, new System.Text.Json.JsonSerializerOptions { WriteIndented = true });
    }
    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
            try { await _module.DisposeAsync(); } catch (JSDisconnectedException) { }
    }
}

@page "/editor/razor-pages"
@model Azunt.Web.Pages.Editor.RazorModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var browserDefault = Model.HttpContext.Request.Query["rendering"] == "browser";
    var view = Model.HttpContext.Request.Query["mode"] == "view";
    var classic = Model.HttpContext.Request.Query["toolbar"] == "classic";
    var showGroupLabels = Model.HttpContext.Request.Query["labels"] != "false";
    var noteToolbar = Model.HttpContext.Request.Query["toolbar"] == "note";
    var storedImages = HostEnvironment.IsDevelopment() && Model.HttpContext.Request.Query["images"] == "stored";
    var saveImagesOnSubmit = HostEnvironment.IsDevelopment() &&
        (Model.HttpContext.Request.Query["images"] == "save");
    var imageUploadUrl = storedImages ? "/editor/demo-images" : null;
}
<p class="document-meta">Image mode: @(storedImages ? "upload on insert" : saveImagesOnSubmit ? "store on save" : "inline Base64") ·
    <a href="?">Inline</a> · <a href="?images=stored">Upload on insert</a> · <a href="?images=save">Store on Save</a></p>
<p class="document-meta">Toolbar: <a href="?">Compact</a> · <a href="?toolbar=note">Notes (one row)</a> · <a href="?toolbar=note&amp;labels=false">Notes (no group labels)</a> · <a href="?toolbar=classic">Classic</a></p>
<h1>Azunt.Editor — Razor Pages</h1>
<p class="document-meta">Mode: <a href="?">Edit</a> · <a href="?mode=view">View</a></p>
<p class="document-meta">Content rendering: <a href="?">Standard</a> · <a href="?rendering=browser">Browser Default</a> · <a href="?rendering=browser&amp;mode=view">Browser Default (View)</a></p>
<p>Submit the form to test Razor Pages model binding and session-scoped persistence.</p>
@if (view)
{
    <azunt-editor id="azunt-razor-demo" name="Html" value="@Model.Html" content-rendering="@(browserDefault ? "BrowserDefault" : "Standard")" mode="View" />
}
else
{
    <form method="post">
        @Html.AntiForgeryToken()
        <azunt-editor id="azunt-razor-demo" name="Html" value="@Model.Html" content-rendering="@(browserDefault ? "BrowserDefault" : "Standard")" height="340" toolbar-mode="@(classic ? "Classic" : "Compact")" show-menu-bar="@(!noteToolbar)" show-toolbar-group-labels="@showGroupLabels" upload-url="@imageUploadUrl" />
        <div class="actions">
            <button class="primary" type="submit">Save HTML</button>
            <azunt-export-buttons />
        </div>
    </form>
}
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
<div asp-validation-summary="All" class="validation"></div>
<h2>Submitted HTML (escaped source)</h2>
<pre class="source">@Model.Html</pre>

@model EditorDemoViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@{
    var view = Context.Request.Query["mode"] == "view";
    var classic = Context.Request.Query["toolbar"] == "classic";
    var showGroupLabels = Context.Request.Query["labels"] != "false";
    var noteToolbar = Context.Request.Query["toolbar"] == "note";
    var storedImages = HostEnvironment.IsDevelopment() && Context.Request.Query["images"] == "stored";
    var saveImagesOnSubmit = HostEnvironment.IsDevelopment() &&
        (Context.Request.Query["images"] == "save");
    var imageUploadUrl = storedImages ? "/editor/demo-images" : null;
    var queryParameters = new List<string>();
    if (storedImages) queryParameters.Add("images=stored");
    else if (saveImagesOnSubmit) queryParameters.Add("images=save");
    if (!showGroupLabels) queryParameters.Add("labels=false");
    if (noteToolbar) queryParameters.Add("toolbar=note");
    else if (classic) queryParameters.Add("toolbar=classic");
    var formAction = "/editor/mvc" + (queryParameters.Count > 0 ? "?" + string.Join("&", queryParameters) : "");
}
<p class="document-meta">Image mode: @(storedImages ? "upload on insert" : saveImagesOnSubmit ? "store on save" : "inline Base64") ·
    <a href="?">Inline</a> · <a href="?images=stored">Upload on insert</a> · <a href="?images=save">Store on Save</a></p>
<p class="document-meta">Toolbar: <a href="?">Compact</a> · <a href="?toolbar=note">Notes (one row)</a> · <a href="?toolbar=note&amp;labels=false">Notes (no group labels)</a> · <a href="?toolbar=classic">Classic</a></p>
<h1>Azunt.Editor — MVC</h1>
<p class="document-meta">Mode: <a href="?">Edit</a> · <a href="?mode=view">View</a></p>
<p>Submit the form to test MVC model binding and session-scoped HTML persistence.</p>
@if (view)
{
    <azunt-editor id="azunt-mvc-demo" name="Html" value="@Model.Html" mode="View" />
}
else
{
    <form action="@formAction" method="post">
        @Html.AntiForgeryToken()
        <azunt-editor id="azunt-mvc-demo" name="Html" value="@Model.Html" height="340" toolbar-mode="@(classic ? "Classic" : "Compact")" show-menu-bar="@(!noteToolbar)" show-toolbar-group-labels="@showGroupLabels" upload-url="@imageUploadUrl" />
        <div class="actions">
            <button class="primary" type="submit">Save HTML</button>
            <azunt-export-buttons />
        </div>
    </form>
}
@if (!string.IsNullOrWhiteSpace(Model.Notice)) { <p class="notice" role="status">@Model.Notice</p> }
<div asp-validation-summary="All" class="validation"></div>
<h2>Submitted HTML (escaped source)</h2>
<pre class="source">@Model.Html</pre>

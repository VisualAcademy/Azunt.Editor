@page "/editor/extensions"
@rendermode InteractiveServer
@using Azunt.Editor.Components
@using Azunt.Editor.Models
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<ExtensionDemo> Logger

<h1>Azunt.Editor — Extension Demo</h1>
<p>Place the caret or select text in the editor, then choose <strong>Pick</strong> in the toolbar. The host dialog inserts your selection at the saved position.</p>
<AzuntEditor @ref="_editor" Id="extension-demo-editor" @bind-Value="_html" Height="300"
             CustomCommands="Commands" CustomCommandWithSelectionInvoked="PickAsync" />
@if (!string.IsNullOrEmpty(_notice))
{
    <p class="notice" role="status">@_notice</p>
}
<dialog @ref="_picker" aria-labelledby="extension-picker-title">
    <h2 id="extension-picker-title">Choose host content</h2>
    <p>Fictional examples only. The application owns the picker and its data.</p>
    <div class="actions">
        <button type="button" data-pick="text">Quick note</button>
        <button type="button" data-pick="html">Formatted approval</button>
        <button type="button" data-pick="image">Sample signature image</button>
        <button type="button" data-pick="cancel">Cancel</button>
    </div>
</dialog>

@code {
    private static readonly IReadOnlyList<EditorCustomCommand> Commands = new[]
    {
        new EditorCustomCommand { Id = "hostPicker", Label = "Pick host content", Icon = "Pick", Group = "Insert", Placement = "Toolbar", CaptureSelection = true }
    };
    private AzuntEditor? _editor;
    private ElementReference _picker;
    private IJSObjectReference? _module;
    private string _html = "<h2>Sample approval</h2><p>Place the caret here: [approval]</p><p>End of document.</p>";
    private string? _notice;
    private bool _picking;

    private async Task PickAsync(EditorCommandContext context)
    {
        var editor = _editor;
        var token = context.SelectionToken;
        if (editor is null || token is null)
        {
            _notice = "Select an editable location first.";
            return;
        }
        if (_picking)
        {
            await editor.ReleaseSelectionAsync(token);
            return;
        }
        _picking = true;
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/extension-demo.js");
            var choice = await _module.InvokeAsync<string?>("pickContent", _picker);
            if (choice is null)
            {
                _notice = "Canceled; the document was not changed.";
                return;
            }
            var inserted = choice switch
            {
                "text" => await editor.InsertTextAsync(token, "Reviewed by example reviewer."),
                "html" => await editor.InsertHtmlAsync(token, "<strong>Reviewed</strong> — Example reviewer"),
                "image" => await editor.InsertImageAsync(token, ExportDemoSamples.SignatureDataUrl, "Fictional signature", 180),
                _ => false
            };
            _notice = inserted ? "Inserted. Use Undo to reverse this action." : "The insertion position is no longer available. Select a location and try again.";
        }
        catch (JSDisconnectedException) { }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Extension demo picker failed.");
            _notice = "Unable to insert host content.";
        }
        finally
        {
            _picking = false;
            try { await editor.ReleaseSelectionAsync(token); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try { await _module.DisposeAsync(); }
            catch (JSDisconnectedException) { }
        }
    }
}

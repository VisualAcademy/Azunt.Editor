@namespace Azunt.Editor.Components
@using Azunt.Editor.Rendering
@using Azunt.Editor.Models
@using Microsoft.JSInterop
@using System.IO
@using System.Text
@implements IAsyncDisposable
@inject IJSRuntime JS

@((MarkupString)_initialMarkup)

@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] public string Name { get; set; } = "Html";
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public int Height { get; set; } = 320;
    [Parameter] public bool ReadOnly { get; set; }
    /// <summary>View hides editing tools and displays the HTML as a read-only document.</summary>
    [Parameter] public EditorMode Mode { get; set; } = EditorMode.Edit;
    [Parameter] public string? UploadUrl { get; set; }
    [Parameter] public string ToolbarMode { get; set; } = "Compact";
    /// <summary>Display the Compact toolbar's menu row (File, Edit, View, etc.).</summary>
    [Parameter] public bool ShowMenuBar { get; set; } = true;
    /// <summary>Display toolbar group headings; More panel headings remain visible.</summary>
    [Parameter] public bool ShowToolbarGroupLabels { get; set; } = true;
    [Parameter] public IReadOnlyList<EditorCustomCommand>? CustomCommands { get; set; }
    [Parameter] public EventCallback<string> CustomCommandInvoked { get; set; }

    private string _editorId = $"azunt-editor-{Guid.NewGuid():N}";
    private string _initialMarkup = string.Empty;
    private DotNetObjectReference<AzuntEditor>? _reference;
    private bool _mounted;
    private bool _rendered;
    private EditorMode _appliedMode = EditorMode.Edit;
    private bool _appliedShowMenuBar = true;
    private bool _appliedShowToolbarGroupLabels = true;
    private long _lastAppliedRevision;
    private const long MaxDocumentBytes = 16L * 1024 * 1024;

    // JavaScript owns the editor's editable DOM after the interactive first render.
    // Rerendering its markup can detach toolbar/canvas handlers and lose live edits.
    protected override bool ShouldRender() => !_rendered;

    protected override void OnInitialized()
    {
        if (!string.IsNullOrWhiteSpace(Id)) _editorId = Id;
        // Hold stable markup across ValueChanged rerenders. JavaScript owns the live DOM.
        _initialMarkup = EditorMarkup.RenderForBlazor(_editorId, Name, Value, Height, ReadOnly, UploadUrl, ToolbarMode, Mode, ShowMenuBar, ShowToolbarGroupLabels);
        _appliedMode = Mode;
        _appliedShowMenuBar = ShowMenuBar;
        _appliedShowToolbarGroupLabels = ShowToolbarGroupLabels;
    }

    // The live DOM belongs to JavaScript; update the mode without Blazor replacing it.
    protected override async Task OnParametersSetAsync()
    {
        if (_mounted && Mode != _appliedMode)
            await SetModeAsync(Mode);
        if (_mounted && ShowMenuBar != _appliedShowMenuBar)
            await SetShowMenuBarAsync(ShowMenuBar);
        if (_mounted && ShowToolbarGroupLabels != _appliedShowToolbarGroupLabels)
            await SetShowToolbarGroupLabelsAsync(ShowToolbarGroupLabels);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _reference = DotNetObjectReference.Create(this);
            _rendered = true;
        }

        // An interactive render can replace the prerendered DOM node. Re-check
        // the live element on subsequent renders; mount() is idempotent when
        // it already owns the current element.
        if (_reference is not null)
        {
            await JS.InvokeVoidAsync("AzuntEditor.mount", _editorId, _reference);
            _mounted = true;
            // A parent can update Mode while the first interactive mount is still
            // pending; apply that request after the engine is ready.
            if (Mode != _appliedMode)
                await SetModeAsync(Mode);
            if (ShowMenuBar != _appliedShowMenuBar)
                await SetShowMenuBarAsync(ShowMenuBar);
            if (ShowToolbarGroupLabels != _appliedShowToolbarGroupLabels)
                await SetShowToolbarGroupLabelsAsync(ShowToolbarGroupLabels);
            if (CustomCommands is { Count: > 0 })
                await JS.InvokeVoidAsync("AzuntEditor.setCommands", _editorId, CustomCommands);
        }
    }

    [JSInvokable]
    public Task OnCustomCommand(string id) => CustomCommandInvoked.InvokeAsync(id);

    /// <summary>Replace custom commands after the editor has mounted, without rerendering its document.</summary>
    public async ValueTask SetCustomCommandsAsync(IReadOnlyList<EditorCustomCommand>? commands)
    {
        if (!_mounted) throw new InvalidOperationException("The editor must be mounted before custom commands can be changed.");
        await JS.InvokeVoidAsync("AzuntEditor.setCommands", _editorId, commands ?? Array.Empty<EditorCustomCommand>());
    }


    public ValueTask SetToolbarModeAsync(string mode)
        => JS.InvokeVoidAsync("AzuntEditor.setToolbarMode", _editorId, mode);

    /// <summary>Show or hide the Compact menu row without replacing the current document.</summary>
    public async ValueTask SetShowMenuBarAsync(bool show)
    {
        if (!_mounted) throw new InvalidOperationException("The editor must be mounted before its menu visibility can be changed.");
        await JS.InvokeVoidAsync("AzuntEditor.setShowMenuBar", _editorId, show);
        ShowMenuBar = show;
        _appliedShowMenuBar = show;
    }

    /// <summary>Change toolbar headings without replacing the current document.</summary>
    public async ValueTask SetShowToolbarGroupLabelsAsync(bool show)
    {
        if (!_mounted) throw new InvalidOperationException("The editor must be mounted before its toolbar labels can be changed.");
        await JS.InvokeVoidAsync("AzuntEditor.setShowToolbarGroupLabels", _editorId, show);
        ShowToolbarGroupLabels = show;
        _appliedShowToolbarGroupLabels = show;
    }

    /// <summary>Change between Edit and View without replacing or losing the current HTML.</summary>
    public async ValueTask SetModeAsync(EditorMode mode)
    {
        if (!Enum.IsDefined(mode)) throw new ArgumentOutOfRangeException(nameof(mode));
        if (!_mounted) throw new InvalidOperationException("The editor must be mounted before its mode can be changed.");
        await JS.InvokeVoidAsync("AzuntEditor.setMode", _editorId, mode == EditorMode.View ? "View" : "Edit");
        Mode = mode;
        _appliedMode = mode;
    }

    [JSInvokable]
    public Task OnHtmlChanged(string html, long revision)
        => ApplyChangedHtmlAsync(html, revision);

    [JSInvokable]
    public async Task OnHtmlStreamChanged(IJSStreamReference htmlStream, long revision)
    {
        // This prevents an image converted to Base64 from exceeding SignalR's
        // 32 KiB maximum JS -> .NET invocation message size. The stream is bounded.
        var html = await ReadHtmlStreamAsync(htmlStream);
        await ApplyChangedHtmlAsync(html, revision);
    }

    private async Task ApplyChangedHtmlAsync(string html, long revision)
    {
        // Streaming calls can complete out of order. Never reapply stale HTML.
        if (revision <= _lastAppliedRevision) return;
        _lastAppliedRevision = revision;
        if (html == Value) return;
        Value = html;
        await ValueChanged.InvokeAsync(html);
    }

    private static async Task<string> ReadHtmlStreamAsync(IJSStreamReference htmlStream)
    {
        await using (htmlStream)
        {
            await using var stream = await htmlStream.OpenReadStreamAsync(maxAllowedSize: MaxDocumentBytes);
            using var reader = new StreamReader(stream, new UTF8Encoding(false, true));
            return await reader.ReadToEndAsync();
        }
    }

    /// <summary>Read current browser state using Blazor streaming, including images.</summary>
    public async ValueTask<string> GetHtmlAsync()
    {
        var htmlStream = await JS.InvokeAsync<IJSStreamReference>("AzuntEditor.getHtmlStream", _editorId);
        return await ReadHtmlStreamAsync(htmlStream);
    }

    /// <summary>Returns the current print page settings selected in the toolbar.</summary>
    public ValueTask<Azunt.Editor.Models.EditorPageSettings> GetPageSettingsAsync()
        => JS.InvokeAsync<Azunt.Editor.Models.EditorPageSettings>("AzuntEditor.getPageSettings", _editorId);

    /// <summary>Programmatically replace the current document.</summary>
    public async ValueTask SetHtmlAsync(string html)
    {
        Value = html;
        await JS.InvokeVoidAsync("AzuntEditor.setHtml", _editorId, html);
        await ValueChanged.InvokeAsync(html);
    }

    public async ValueTask DisposeAsync()
    {
        if (_mounted)
        {
            try { await JS.InvokeVoidAsync("AzuntEditor.unmount", _editorId); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        _reference?.Dispose();
    }
}

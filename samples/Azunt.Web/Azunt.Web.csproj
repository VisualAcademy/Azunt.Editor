<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Azunt.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalEditorPackage)' != 'true'">
    <ProjectReference Include="../../src/Azunt.Editor/Azunt.Editor.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalEditorPackage)' == 'true'">
    <PackageReference Include="Azunt.Editor" Version="0.5.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalExportPackage)' != 'true'">
    <ProjectReference Include="../../src/Azunt.Editor.Export/Azunt.Editor.Export.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalExportPackage)' == 'true'">
    <PackageReference Include="Azunt.Editor.Export" Version="0.5.3" />
  </ItemGroup>
</Project>

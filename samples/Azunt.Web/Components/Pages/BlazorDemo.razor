@page "/editor/blazor"
@rendermode InteractiveServer
@using Azunt.Editor.Components
@using Azunt.Editor.Models
@using Azunt.Editor.Export.Models
@using Azunt.Editor.Export.Html
@using Azunt.Web.Images
@using Azunt.Editor.Export.Components
@using Microsoft.JSInterop
@inject IEditorExportService ExportService
@inject IJSRuntime JS
@inject ILogger<BlazorDemo> Logger
@inject NavigationManager Navigation
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Azunt.Editor.Storage.FileSystemEditorImageStore ImageStore
@inject EditorInlineImagePersistence ImagePersistence

<h1>Azunt.Editor — Blazor Server</h1>
<p class="document-meta">Image mode: @(UseStoredImages ? "upload on insert" : UseDeferredImages ? "store on save" : "inline Base64") ·
    <a href="/editor/blazor">Inline</a> · <a href="/editor/blazor?images=stored">Upload on insert</a> · <a href="/editor/blazor?images=save">Store on Save</a></p>
<p>Interactive Server component using the same JavaScript editor engine. ·
    <a href="/editor/blazor">Compact toolbar</a> · <a href="/editor/blazor?toolbar=classic">Classic toolbar</a> · <a href="/editor/blazor?toolbar=note">Notes (one row)</a> · <a href="/editor/blazor?toolbar=note&amp;labels=false">Notes (no group labels)</a></p>

<p class="document-meta"><label><input type="checkbox" @bind="_showMenuBar" /> Show top menu row</label> · <label><input type="checkbox" @bind="_showToolbarGroupLabels" /> Show toolbar group labels</label></p>
<p class="document-meta">Mode: <a href="/editor/blazor?mode=view">Start in View</a> · <button type="button" @onclick="ToggleMode">
    @(_demoMode == EditorMode.Edit ? "Switch to View" : "Switch to Edit")
</button></p>

<p class="document-meta"><label>Content rendering:
    <select @bind="_contentRendering">
        <option value="Standard">Standard</option>
        <option value="BrowserDefault">Browser Default</option>
    </select>
</label></p>

<AzuntEditor @key="UseStoredImages" @ref="_editor" Id="azunt-blazor-demo" Name="BlazorHtml" @bind-Value="_html" Height="340" UploadUrl="@(UseStoredImages ? "/editor/demo-images" : null)"
    Mode="@_demoMode" ContentRendering="@_contentRendering" ToolbarMode="@(UseClassic ? "Classic" : "Compact")" ShowMenuBar="@_showMenuBar" ShowToolbarGroupLabels="@_showToolbarGroupLabels" CustomCommands="EditorCommands" CustomCommandInvoked="HandleEditorCommand" />

<div class="actions">
    <button class="primary" @onclick="SaveAsync">Save HTML</button>
    <button @onclick="RestoreAsync">Restore saved HTML</button>
    <AzuntExportButtons ExportRequested="ExportAsync" />
</div>
@if (!string.IsNullOrEmpty(_notice))
{
    <p class="notice" role="status">@_notice</p>
}
<h2>Last saved HTML (escaped source)</h2>
@if (_savedHtml.Length > 0)
{
    <p class="document-meta">Saved @_savedHtml.Length characters, including @CountImages(_savedHtml) image(s).
       Only the first 4,000 characters are shown to keep large Base64 images from freezing the demo page.</p>
}
<pre class="source">@(_savedHtml.Length > 4000 ? _savedHtml[..4000] + "\n... (source preview truncated; full HTML remains saved in memory)" : _savedHtml)</pre>

@code {
    private bool UseClassic => new Uri(Navigation.Uri).Query.Contains("toolbar=classic", StringComparison.OrdinalIgnoreCase);
    private static readonly IReadOnlyList<EditorCustomCommand> EditorCommands = new[] {
        new EditorCustomCommand { Id = "downloadPdf", Label = "Download PDF", Group = "Export" },
        new EditorCustomCommand { Id = "downloadWord", Label = "Download Word", Group = "Export" },
        new EditorCustomCommand { Id = "downloadExcel", Label = "Download Excel", Group = "Export" }
    };
    private Task HandleEditorCommand(string id) => id switch {
        "downloadPdf" => ExportAsync(EditorExportFormat.Pdf),
        "downloadWord" => ExportAsync(EditorExportFormat.Docx),
        "downloadExcel" => ExportAsync(EditorExportFormat.Xlsx),
        _ => Task.CompletedTask
    };

    private bool UseStoredImages => HostEnvironment.IsDevelopment() &&
        new Uri(Navigation.Uri).Query.Contains("images=stored", StringComparison.OrdinalIgnoreCase);
    private bool UseDeferredImages => HostEnvironment.IsDevelopment() &&
        new Uri(Navigation.Uri).Query.Contains("images=save", StringComparison.OrdinalIgnoreCase);
    private AzuntEditor? _editor;
    private EditorContentRendering _contentRendering = EditorContentRendering.Standard;
    private EditorMode _demoMode = EditorMode.Edit;
    private bool _showMenuBar = true;
    private bool _showToolbarGroupLabels = true;

    protected override void OnInitialized()
    {
        // Allows View to appear in the initial server response, before SignalR/JS.
        if (new Uri(Navigation.Uri).Query.Contains("mode=view", StringComparison.OrdinalIgnoreCase))
            _demoMode = EditorMode.View;
        if (new Uri(Navigation.Uri).Query.Contains("toolbar=note", StringComparison.OrdinalIgnoreCase))
            _showMenuBar = false;
        if (new Uri(Navigation.Uri).Query.Contains("labels=false", StringComparison.OrdinalIgnoreCase))
            _showToolbarGroupLabels = false;
    }

    private void ToggleMode()
    {
        // Let the child handle mode changes through its Mode parameter.
        // Avoid making a second direct JS call during the initial Blazor mount.
        _demoMode = _demoMode == EditorMode.Edit ? EditorMode.View : EditorMode.Edit;
    }
    private string _html = "<h2>Blazor Server demo</h2><p>Select text to format it, or add multiple images.</p>";
    private string _savedHtml = "";
    private string? _notice;

    private static int CountImages(string html)
        => System.Text.RegularExpressions.Regex.Matches(html, @"<img(?:\s|>)", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Count;

    private async Task SaveAsync()
    {
        if (_editor is null)
        {
            _notice = "Editor component reference is unavailable.";
            return;
        }
        try
        {
            var html = await _editor.GetHtmlAsync();
            if (UseDeferredImages)
            {
                var result = await DemoImageSaveService.PersistAsync(ImagePersistence, ImageStore, html);
                _savedHtml = result.Html;
                // Replace the live editor HTML so Source mode shows short paths after Save.
                if (result.SavedImageCount > 0)
                    await _editor.SetHtmlAsync(_savedHtml);
                _notice = $"Saved {result.SavedImageCount} image file(s). HTML remains in this component's memory.";
            }
            else
            {
                _savedHtml = EditorHtmlSanitizer.Sanitize(html, ImageStore.IsManagedUrl);
                _notice = "Saved to this component's memory (not persisted across reloads).";
            }
            _html = _savedHtml;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blazor editor HTML save failed.");
            _notice = "Save failed. Check the application logs for details.";
        }
    }

    private async Task ExportAsync(EditorExportFormat format)
    {
        if (_editor is null) { _notice = "Editor component reference is unavailable."; return; }
        try
        {
            var html = await _editor.GetHtmlAsync(); // Always current DOM, not stale bind state.
            var page = await _editor.GetPageSettingsAsync();
            var result = await ExportService.ExportAsync(html, format, new EditorExportOptions
            {
                FileName = "Azunt-Blazor-Report", Title = "Blazor editor report",
                PaperSize = page.PaperSize, Orientation = page.Orientation, Margin = page.Margin
            });
            using var stream = new MemoryStream(result.Content, writable: false);
            using var reference = new DotNetStreamReference(stream);
            await JS.InvokeVoidAsync("AzuntEditorExport.download", result.FileName, reference);
            _notice = $"Created {result.FileName} ({result.Content.Length:N0} bytes).";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blazor editor export failed for format {Format}.", format);
            _notice = "Download failed. Check the application logs for details.";
        }
    }

    private async Task RestoreAsync()
    {
        if (_editor is null)
        {
            _notice = "Editor component reference is unavailable.";
            return;
        }
        try
        {
            await _editor.SetHtmlAsync(_savedHtml);
            _notice = "Restored the last saved HTML.";
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Blazor editor restore failed.");
            _notice = "Restore failed. Check the application logs for details.";
        }
    }
}
